<launch>


    <!-- what ros bag to play -->
    <arg name="bag_name"    default="room_dark_03" />
    <arg name="bag_path"    default="/root/data" />

    <!-- where to save the recorded poses -->
    <arg name="path_save"   default="/root/data/m2dgr/lvisam/dark_room03" />
    <arg name="file_name"   default="ov_dark_room03" />


    <!-- record the trajectory -->
    <node name="recorder_estimate" pkg="ov_eval" type="pose_to_file" output="screen" required="true">
        <param name="topic"      type="str" value="/ov_msckf/odomimu" />
        <param name="topic_type" type="str" value="Odometry" />
        <param name="output"     type="str" value="$(arg path_save)/$(arg file_name).txt" />
    </node>


    <!-- play the dataset -->
    <node pkg="rosbag" type="play" name="rosbag" args="-r 1 $(arg bag_path)/$(arg bag_name).bag" required="true"/>


</launch>
